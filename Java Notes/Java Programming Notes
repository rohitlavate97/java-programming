import java.io.FileReader;
public class Demo {
    public static void main(String[] args) {
        FileReader fr = null;
        try {
            System.out.println("Main method started");
            fr = new FileReader("abc.txt");               //until this program is reading file, no other program can access it. so after work finish, close link.
            int result = fr.read();
            System.out.println("Data = " + result);
        } catch (Exception e) {
            e.printStackTrace();
        } finally {
            System.out.println("Inside finally block");
            try {
                if (fr != null) {
                    fr.close();      // Resource cleanup
                    System.out.println("File closed");
                }
            } catch (Exception e) {
                e.printStackTrace();
            }
        }
        System.out.println("Main method ended");
    }
}

